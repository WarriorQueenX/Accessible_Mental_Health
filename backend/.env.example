# Copy to .env and adjust. FastAPI app reads these via os.getenv (app/config.py).

# 1 = mocked STT (no model download needed, everything else runs for real)
# 0 = load real ai4bharat/indicwav2vec-v1-all checkpoint (needs torch+transformers+internet/GPU)
SAATHI_MOCK_MODE=1

SAATHI_STT_MODEL=ai4bharat/indicwav2vec-v1-all
SAATHI_UPLOAD_DIR=./uploads
SAATHI_DB_PATH=./saathi_voice.db
